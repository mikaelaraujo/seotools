def extract_reddit_comments(url, client_id, client_secret, user_agent, max_comments, min_length):
    """Extract comments from Reddit post"""
    try:
        reddit = praw.Reddit(
            client_id=client_id,
            client_secret=client_secret,
            user_agent=user_agent
        )
        
        submission = reddit.submission(url=url)
        submission.comments.replace_more(limit=0)
        
        comments = []
        for comment in submission.comments.list():
            if hasattr(comment, 'body'):
                body = comment.body.strip()
                if len(body) >= min_length and body not in ['[deleted]', '[removed]']:
                    comments.append(body)
                    if len(comments) >= max_comments:
                        break
        
        return comments, submission
        
    except Exception as e:
        st.error(f"Error extracting comments: {str(e)}")
        return [], None


def generate_questions(comments, api_key, model, num_questions):
    """Generate questions using Gemini AI"""
    try:
        client = genai.Client(api_key=api_key)
        comments_text = "\n\n---\n\n".join(comments[:25])
        
        prompt = f"""You are an SEO content analyst specializing in understanding user queries.

Analyze the following Reddit comments and identify the main QUESTIONS and CONCERNS users have about this topic.

IMPORTANT:
- Extract REAL questions users are asking or implying
- Identify problems and concerns mentioned
- Create clear questions that a Google user would ask
- For each question, provide an expected answer based on the comment consensus

COMMENTS:
{comments_text}

Generate {num_questions} relevant questions.

Return ONLY valid JSON (no markdown):
[
  {{
    "question": "Clear and specific question",
    "expected_answer": "Answer based on comments and community consensus",
    "context": "Brief context about why this question matters"
  }}
]"""

        response = client.models.generate_content(
            model=model,
            contents=prompt
        )
        
        response_text = response.text.strip()
        
        # Remove markdown
        if "```json" in response_text:
            response_text = response_text.split("```json")[1].split("```")[0].strip()
        elif "```" in response_text:
            response_text = response_text.split("```")[1].split("```")[0].strip()
        
        questions = json.loads(response_text)
        return questions
        
    except Exception as e:
        st.error(f"Error generating questions: {str(e)}")
        return []


def analyze_content_coverage(article, questions, api_key, model):
    """Analyze if article answers the questions"""
    try:
        client = genai.Client(api_key=api_key)
        
        results = {
            "total_questions": len(questions),
            "answered_completely": 0,
            "answered_partially": 0,
            "not_answered": 0,
            "details": []
        }
        
        progress_bar = st.progress(0)
        status_text = st.empty()
        
        for i, question in enumerate(questions):
            status_text.text(f"Analyzing question {i+1}/{len(questions)}...")
            progress_bar.progress((i + 1) / len(questions))
            
            article_limited = article[:8000]
            
            prompt = f"""Analyze if the ARTICLE answers the QUESTION.

QUESTION: {question['question']}

ARTICLE:
{article_limited}

Evaluate:
1. Does the article answer the question completely? (COMPLETE/PARTIAL/NO)
2. If COMPLETE or PARTIAL, briefly cite the relevant part
3. If NO or PARTIAL, what is missing?
4. Give a score from 0 to 10 for answer quality

Return ONLY valid JSON (no markdown):
{{
  "status": "COMPLETE" or "PARTIAL" or "NO",
  "citation": "Relevant excerpt or info in article",
  "gap": "What is missing to answer better",
  "score": 8
}}"""

            response = client.models.generate_content(
                model=model,
                contents=prompt
            )
            
            response_text = response.text.strip()
            if "```json" in response_text:
                response_text = response_text.split("```json")[1].split("```")[0].strip()
            elif "```" in response_text:
                response_text = response_text.split("```")[1].split("```")[0].strip()
            
            analysis = json.loads(response_text)
            
            if analysis['status'] == 'COMPLETE':
                results['answered_completely'] += 1
            elif analysis['status'] == 'PARTIAL':
                results['answered_partially'] += 1
            else:
                results['not_answered'] += 1
            
            results['details'].append({
                "question": question['question'],
                "context": question.get('context', ''),
                "status": analysis['status'],
                "score": analysis.get('score', 0),
                "citation": analysis.get('citation'),
                "gap": analysis.get('gap')
            })
            
            time.sleep(0.5)  # Rate limiting
        
        progress_bar.empty()
        status_text.empty()
        
        return results
        
    except Exception as e:
        st.error(f"Error analyzing coverage: {str(e)}")
        return None

